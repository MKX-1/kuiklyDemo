# 统一换行符：源码进仓库一律用 LF，避免 Windows 上出现满屏 CRLF 警告
* text=auto

*.kt   text eol=lf
*.kts  text eol=lf
*.java text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
gradlew text eol=lf

# Windows 批处理必须保留 CRLF，否则执行会出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行处理
*.png binary
*.jpg binary
*.jar binary
*.webp binary
